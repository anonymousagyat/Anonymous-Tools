<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnonymousTools" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/cream_background</item>
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AnonymousTools.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">16dp</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AnonymousTools.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
